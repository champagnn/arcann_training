{
    "hpc1":
    {
        "hostname": "hpc1_address",
        "walltime_format": "hours",
        "job_scheduler": "slurm",
        "launch_command": "sbatch",
        "max_jobs" : -1,
        "max_array_size" : 10000,
        "a100_myproject1": {
            "project_name": "myproject1",
            "allocation_name": "a100",
            "arch_name": "a100",
            "arch_type": "gpu",
            "partition": "gpu_p1",
            "subpartition": "a100",
            "qos": {"qos_gpu-normal": 72000, "qos_gpu-long": 360000},
            "valid_for":  ["training"]
        },

        "cpu_myproject1": {
            "project_name": "myproject1",
            "allocation_name": "cpu",
            "arch_name": "cpu",
            "arch_type": "cpu",
            "partition": "cpu_p",
            "subpartition": null,
            "qos": {"qos_cpu-normal": 72000, "qos_cpu-long": 360000},
            "valid_for": ["labeling"],
            "default": ["labeling"]
        },

        "h100_myproject1": {
            "project_name": "myproject1",
            "allocation_name": "h100",
            "arch_name": "h100",
            "arch_type": "gpu",
            "partition": "gpu_p3",
            "subpartition": null,
            "qos": {"qos_gpu-normal": 72000, "qos_gpu-long": 360000},
            "valid_for":  ["freezing","compressing","exploration","test","training"],
            "default": ["trainig","freezing","compressing","exploration","test"]
        }
    }
}
